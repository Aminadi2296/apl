---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
import { t, routes, carPaths, money, num, type Lang } from '../i18n/ui';
const { lang, car } = Astro.props as { lang: Lang; car: any };
const u = t(lang).inv;
const name = `${car.year} ${car.make} ${car.model}`;
const title = `${name} – ${money(car.price)} | ${site.name}`;
const desc = `${name}, ${num(car.miles)} ${u.miles}, ${car.transmission}, ${car.color}. ${money(car.price)}.`;
const jsonLd = [{ '@context': 'https://schema.org', '@type': 'Vehicle', name, brand: car.make, model: car.model, vehicleModelDate: String(car.year), mileageFromOdometer: { '@type': 'QuantitativeValue', value: car.miles, unitCode: 'SMI' }, vehicleIdentificationNumber: car.vin, color: car.color, offers: { '@type': 'Offer', price: car.price, priceCurrency: 'USD', availability: 'https://schema.org/InStock' } }];
const rows = [[u.year, car.year], [u.make, car.make], [u.model, car.model], [t(lang).inv.miles, num(car.miles)], [u.trans, car.transmission], [u.fuel, car.fuel], [u.color, car.color], [u.vin, car.vin]];
---
<Layout lang={lang} title={title} description={desc} paths={carPaths(car.slug)} jsonLd={jsonLd}>
  <section class="mx-auto max-w-7xl px-4 py-10">
    <a href={routes.inventory[lang]} class="font-bold text-brand-dark hover:underline">← {u.back}</a>
    <div class="mt-6 grid gap-10 lg:grid-cols-2">
      <img src={car.image} alt={name} width="640" height="400" class="w-full rounded-xl bg-mist" />
      <div>
        <h1 class="text-4xl font-extrabold">{name}</h1>
        <p class="mt-3 font-display text-5xl font-extrabold">{money(car.price)}</p>
        <a href={routes.apply[lang]} class="btn btn-primary mt-6">{u.finance}</a>
        <h2 class="mt-10 text-2xl font-bold">{u.specs}</h2>
        <dl class="mt-3 divide-y divide-navy/10">
          {rows.map(([k, v]) => <div class="flex justify-between py-2"><dt class="text-navy/70">{k}</dt><dd class="font-bold">{v}</dd></div>)}
        </dl>
      </div>
    </div>
  </section>
</Layout>

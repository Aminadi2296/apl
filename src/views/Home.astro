---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import FlagCarousel from '../components/FlagCarousel.astro';
import CarCard from '../components/CarCard.astro';
import cars from '../data/cars.json';
import { t, routes, pathsOf, type Lang } from '../i18n/ui';
const { lang } = Astro.props as { lang: Lang };
const u = t(lang);
const [title, desc] = u.seo.home;
const whyIcons = [
  '<path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"/>',
  '<circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/><path d="m8.5 11 2 2 3.5-4"/>',
  '<rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/>',
  '<path d="M20.6 13.4l-7.2 7.2a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8z"/><circle cx="7.5" cy="7.5" r="1.5"/>',
];
const featured = cars.filter((c) => c.featured).slice(0, 4);
---
<Layout lang={lang} title={title} description={desc} paths={pathsOf('home')}>
  <Hero lang={lang} />
  <Marquee lang={lang} />
  <section class="mx-auto max-w-7xl px-4 py-16">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h2 class="text-3xl font-extrabold md:text-4xl">{u.featured.title}</h2>
      <a class="btn btn-dark" href={routes.inventory[lang]}>{u.featured.all}</a>
    </div>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {featured.map((car) => <CarCard car={car} lang={lang} />)}
    </div>
  </section>
  <FlagCarousel lang={lang} />
  <section class="mx-auto max-w-7xl px-4 py-16">
    <h2 class="text-3xl font-extrabold md:text-4xl">{u.steps.title}</h2>
    <ol class="mt-8 grid gap-6 md:grid-cols-4">
      {u.steps.items.map(([h, p], i) => (
        <li class="border-t-4 border-brand pt-4">
          <span class="font-display text-4xl font-extrabold text-brand">{i + 1}</span>
          <h3 class="mt-1 text-xl font-bold">{h}</h3>
          <p class="mt-1 text-navy/75">{p}</p>
        </li>
      ))}
    </ol>
  </section>
  <section class="bg-navy py-20 text-white">
    <div class="mx-auto max-w-7xl px-4">
      <div class="grid gap-6 md:grid-cols-2 md:items-end">
        <div>
          <p class="font-bold text-brand">{u.why.eyebrow}</p>
          <h2 class="mt-3 max-w-xl text-4xl font-extrabold md:text-5xl">{u.why.title}</h2>
        </div>
        <p class="max-w-md text-white/75 md:justify-self-end">{u.why.sub}</p>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {u.why.items.map(([h, p], i) => (
          <article class="rounded-2xl border border-white/10 bg-white/[0.07] p-7">
            <div class="flex h-16 w-16 items-center justify-center rounded-full bg-navy text-brand">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={whyIcons[i]} />
            </div>
            <h3 class="mt-12 text-lg font-bold">{h}</h3>
            <p class="mt-2 text-sm leading-relaxed text-white/70">{p}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section class="bg-brand py-14 text-center text-navy">
    <h2 class="text-3xl font-extrabold md:text-4xl">{u.cta.title}</h2>
    <p class="mt-2">{u.cta.sub}</p>
    <a class="btn btn-dark mt-6" href={routes.apply[lang]}>{u.cta.btn}</a>
  </section>
</Layout>

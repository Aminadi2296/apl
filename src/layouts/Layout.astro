---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import type { Lang } from '../i18n/ui';

interface Props { lang: Lang; title: string; description: string; paths: { es: string; en: string }; jsonLd?: object[]; noindex?: boolean }
const { lang, title, description, paths, jsonLd = [], noindex = false } = Astro.props;
const url = (p: string) => site.domain + p;
const dealer = {
  '@context': 'https://schema.org', '@type': 'AutoDealer', name: site.name, url: site.domain,
  telephone: site.phone, email: site.email, areaServed: site.address.city,
  address: { '@type': 'PostalAddress', streetAddress: site.address.street, addressLocality: site.address.city, addressRegion: site.address.state, postalCode: site.address.zip, addressCountry: 'US' },
  knowsLanguage: ['es', 'en'],
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={url(paths[lang])} />
    <link rel="alternate" hreflang="es" href={url(paths.es)} />
    <link rel="alternate" hreflang="en" href={url(paths.en)} />
    <link rel="alternate" hreflang="x-default" href={url(paths.es)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url(paths[lang])} />
    <meta property="og:locale" content={lang === 'es' ? 'es_US' : 'en_US'} />
    <meta property="og:image" content={url('/og-image.jpg')} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#16232A" />
    <link rel="icon" type="image/svg+xml" href="/logo-white-small.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,800&family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(dealer)} />
    {jsonLd.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
    <!-- TODO SEM: pegar aquí Google Tag Manager / GA4 / Google Ads cuando existan las cuentas -->
  </head>
  <body class="bg-white antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:bg-white focus:p-3">Skip to content</a>
    <Header lang={lang} paths={paths} />
    <main id="main"><slot /></main>
    <Footer lang={lang} />
  </body>
</html>

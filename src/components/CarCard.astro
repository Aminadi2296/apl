---
// Componente reutilizable de tarjeta de auto. Recibe un objeto de src/data/cars.json
import { t, carPath, money, num, routes, type Lang } from '../i18n/ui';
export interface Car { slug: string; make: string; model: string; year: number; miles: number; price: number; transmission: string; fuel: string; color: string; vin: string; image: string; featured?: boolean }
const { car, lang } = Astro.props as { car: Car; lang: Lang };
const u = t(lang).inv;
const href = carPath(lang, car.slug);
---
<article class="car-card group flex flex-col overflow-hidden rounded-xl border border-navy/10 bg-white" data-make={car.make.toLowerCase()} data-model={car.model.toLowerCase()} data-price={car.price} data-year={car.year}>
  <a href={href} class="block aspect-[8/5] overflow-hidden bg-mist">
    <img src={car.image} alt={`${car.year} ${car.make} ${car.model}`} width="640" height="400" loading="lazy" class="h-full w-full object-cover" />
  </a>
  <div class="flex flex-1 flex-col p-4">
    <h3 class="text-lg font-extrabold"><a href={href}>{car.year} {car.make} {car.model}</a></h3>
    <p class="mt-1 text-sm text-navy/70">{num(car.miles)} {u.miles} · {car.transmission} · {car.color}</p>
    <p class="mt-3 font-display text-3xl font-extrabold">{money(car.price)}</p>
    <div class="mt-4 flex gap-2">
      <a href={href} class="btn btn-dark flex-1 !px-3 !py-2 text-sm">{u.details}</a>
      <a href={routes.apply[lang]} class="btn btn-primary flex-1 !px-3 !py-2 text-sm">{t(lang).nav.cta}</a>
    </div>
  </div>
</article>

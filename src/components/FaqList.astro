---
const { items } = Astro.props as { items: string[][] };
---
<div class="divide-y divide-navy/10 rounded-xl border border-navy/10">
  {items.map(([q, a]) => (
    <details class="group p-5">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-bold">{q}<span class="text-brand text-2xl group-open:rotate-45 transition-transform">+</span></summary>
      <p class="mt-3 max-w-2xl text-navy/80">{a}</p>
    </details>
  ))}
</div>

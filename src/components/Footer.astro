---
import { site } from '../data/site';
import { t, routes, type Lang } from '../i18n/ui';
const { lang } = Astro.props as { lang: Lang };
const u = t(lang);
---
<footer class="bg-navy text-white">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-14 md:grid-cols-3">
    <div>
      <img src="/logo-white.svg" alt="Autos para Latinos" class="h-14 w-auto md:h-16" />
      <p class="mt-3 max-w-xs text-white/75">{u.footer.tag}</p>
    </div>
    <div>
      <h3 class="font-bold">{u.nav.inventory}</h3>
      <ul class="mt-3 space-y-2 text-white/75">
        <li><a class="hover:text-brand" href={routes.inventory[lang]}>{u.nav.inventory}</a></li>
        <li><a class="hover:text-brand" href={routes.inventory[lang] + '?filter=under-20k'}>{u.inv.under} $20k</a></li>
        <li><a class="hover:text-brand" href={routes.inventory[lang] + '?filter=under-10k'}>{u.inv.under} $10k</a></li>
      </ul>
    </div>
    <div>
      <h3 class="font-bold">{u.footer.resources}</h3>
      <ul class="mt-3 space-y-2 text-white/75">
        <li><a class="hover:text-brand" href={routes.apply[lang]}>{u.nav.apply}</a></li>
        <li><a class="hover:text-brand" href={routes.about[lang]}>{u.nav.about}</a></li>
        <li><a class="hover:text-brand" href={routes.contact[lang]}>{u.nav.contact}</a></li>
        <li><a class="hover:text-brand" href={routes.faqs[lang]}>{u.nav.faqs}</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/15 px-4 py-5 text-center text-sm text-white/60">
    © {new Date().getFullYear()} {site.name}. {u.footer.rights}
  </div>
</footer>

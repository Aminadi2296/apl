# Copia este archivo como .env para desarrollo local, y agrega las mismas variables en Vercel
# (Project Settings → Environment Variables).

# --- Resend (formulario de contacto → /api/lead/) ---
# API key: https://resend.com/api-keys  (secreta, nunca usar prefijo PUBLIC_)
RESEND_API_KEY=
# A quién le llegan los mensajes. Varios correos separados por coma.
# Mientras se use onboarding@resend.dev, solo puede ser el correo de tu cuenta de Resend.
LEADS_TO_EMAIL=
# Remitente. Vacío = "Autos para Latinos <onboarding@resend.dev>" (solo pruebas).
# Cuando el dominio esté verificado en Resend: Autos para Latinos <no-reply@autosparalatinos.com>
LEADS_FROM_EMAIL=

# --- Pre-calificación y solicitud completa ---
# Aún sin definir. Si está vacío, esos formularios funcionan en MODO PRUEBA (no envían nada).
PUBLIC_FORM_ENDPOINT=
